<% const c = cosmos(); const l = c.listing; %>
<section class="index-page shell">
  <header class="index-heading"><h1><%= cosmos_listing_title() %><% if (l.title_period) { %><span class="small-dot">.</span><% } %></h1></header>
  <% if (l.categories || c.search.enabled) { %>
  <div class="index-tools">
    <% if (l.categories) { %><nav class="topic-nav" aria-label="<%= cx('filter_topics') %>"><a href="<%= cosmos_route('blog') %>" <%- !page.category && !page.tag && !page.archive ? 'aria-current="page"' : '' %>><%= l.title || cx('all_writing') %><% if (l.counts) { %> <span><%= site.posts.length %></span><% } %></a><% site.tags.sort('name').forEach(tag => { %><a href="<%= url_for(tag.path) %>" <%- page.tag === tag.name ? 'aria-current="page"' : '' %>># <%= tag.name %><% if (l.counts) { %> <span><%= tag.length %></span><% } %></a><% }) %></nav><% } %>
    <% if (c.search.enabled) { %><form class="search-form" role="search" id="search"><label for="post-search" class="sr-only"><%= cx('search') %></label><%- icon('search') %><input id="post-search" type="search" placeholder="<%= cx('search_placeholder') %>" autocomplete="off" name="q"><button class="clear-search" type="button" aria-label="<%= cx('clear_search') %>" hidden><%- icon('close') %></button></form><% } %>
  </div>
  <% } %>
  <div class="post-wrap archive" data-default-list>
    <% if (page.posts?.length) { %>
      <% let last_year = ''; %>
      <% page.posts.forEach(post => { %>
        <% const cur_year = post.date.year(); %>
        <% if (last_year !== cur_year) { %>
          <h3 class="archive-year"><%= cur_year %></h3>
        <% last_year = cur_year; } %>
        <article class="archive-item">
          <a class="archive-item-link" href="<%= url_for(post.path) %>"><%= entry_title(post) %></a>
          <% if (l.date) { %><time class="archive-item-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, config.date_format) %></time><% } %>
        </article>
      <% }) %>
    <% } else { %><p class="empty-message"><%= cx('empty') %></p><% } %>
  </div>
  <% if (page.total > 1) { %><nav class="pagination" aria-label="<%= cx('pagination') %>" data-default-pagination><%- paginator({prev_text:cx('previous'),next_text:cx('next'),mid_size:1,end_size:1}) %></nav><% } %>
</section>
