<%
const c = cosmos();
const chic = c.chic || {};
const navname = chic.navname || c.brand.title || config.title;
const nav = chic.nav || {};
const norm = p => ('/' + String(p || '')).replace(/index\.html$/, '').replace(/\/+/g, '/');
const current = norm(page.path);
function isActive(href) {
  const target = norm(String(href).replace(/^https?:\/\/[^\/]+/i, ''));
  if (target === '/') return current === '/';
  return current === target || current.startsWith(target + '/');
}
%>
<header class="site-header shell">
  <a class="brand" href="<%= cosmos_route('home') %>" aria-label="<%= navname %> — <%= cx('home') %>"><span class="brand-title"><span><%= navname %></span></span></a>
  <div class="header-actions">
    <nav id="site-nav" class="site-nav" aria-label="<%= cx('main_navigation') %>">
      <% for (const [label, path] of Object.entries(nav)) { const href = /^https?:/i.test(path) ? path : url_for(path); %>
      <a class="menu-item<%= isActive(href) ? ' active' : '' %>" href="<%= href %>"<%= isActive(href) ? ' aria-current="page"' : '' %>><%= label %></a>
      <% } %>
    </nav>
    <input id="switch_default" type="checkbox" class="switch_default">
    <label for="switch_default" class="toggleBtn"></label>
    <button class="icon-control menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="<%= cx('open_navigation') %>"><%- icon('menu') %></button>
  </div>
</header>
